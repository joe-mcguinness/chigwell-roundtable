{
  "name": "chigwell-roundtable",
  "private": true,
  "description": "Website for Chigwell Round Table, with Playwright tests",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "test": "playwright test",
    "test:live": "BASE_URL=https://chigwellroundtable.co.uk playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1"
  }
}
